# ============================================================
# Environment Variables Configuration
# Muhammad Auwal Abubakar Portfolio
# ============================================================

# --- Supabase Database, Auth & Storage (Client-side) ---
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co

# Your Supabase Public Anon Key (found in Supabase Settings -> API)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- Contact Form Email Service (Serverless / Nodemailer) ---
# Gmail address used to dispatch notifications
EMAIL_USER=your-email@gmail.com

# Gmail App Password (generated via Google Account -> Security -> 2-Step Verification -> App Passwords)
EMAIL_PASS=your-16-character-app-password

# Email address designated to receive portfolio inquiries
RECEIVER_EMAIL=contact.sardaunatech@gmail.com
