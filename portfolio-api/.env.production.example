# Production Environment Configuration for WhoGoHost Shared Hosting
# Copy to .env on your server and update credentials.

APP_NAME="Muhammad Auwal Abubakar Portfolio API"
APP_ENV=production
APP_KEY=base64:A4jmqHFs2j5pqX77qKc3ZKrSqpbFJpMcRB3/ccQNlAo=
APP_DEBUG=false
APP_TIMEZONE=Africa/Lagos
APP_URL=https://api.muhammad.sardaunatechlabs.com.ng

LOG_CHANNEL=daily
LOG_LEVEL=warning

# WhoGoHost cPanel MySQL Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sardaun1_portfolio
DB_USERNAME=sardaun1_portfolio_user
DB_PASSWORD="REPLACE_WITH_YOUR_CPANEL_DB_PASSWORD"

# Sibling Subdomain Session & Cookie Sharing
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.sardaunatechlabs.com.ng
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Sanctum Stateful Domains & CORS
SANCTUM_STATEFUL_DOMAINS=muhammad.sardaunatechlabs.com.ng,sardauna-portfolio.vercel.app
FRONTEND_URL=https://muhammad.sardaunatechlabs.com.ng
CORS_ALLOWED_ORIGINS=https://muhammad.sardaunatechlabs.com.ng,https://sardauna-portfolio.vercel.app

# Default Initial Administrator
ADMIN_NAME="Muhammad Auwal Abubakar"
ADMIN_EMAIL="admin@sardaunatech.com"
ADMIN_PASSWORD="REPLACE_WITH_STRONG_ADMIN_PASSWORD"

# Local Storage
FILESYSTEM_DISK=public

# Cache & Queues on Shared Hosting
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Email Delivery via Webmail SMTP
MAIL_MAILER=smtp
MAIL_HOST=mail.sardaunatechlabs.com.ng
MAIL_PORT=465
MAIL_USERNAME=contact@sardaunatechlabs.com.ng
MAIL_PASSWORD="REPLACE_WITH_WEBMAIL_PASSWORD"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="contact@sardaunatechlabs.com.ng"
MAIL_FROM_NAME="Muhammad Auwal Abubakar"
RECEIVER_EMAIL="contact.sardaunatech@gmail.com"
