APP_NAME="Muhammad Auwal Abubakar Portfolio API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.muhammad.sardaunatechlabs.com.ng

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL Database Details (WhoGoHost cPanel MySQL Databases)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=whogohostuser_portfolio
DB_USERNAME=whogohostuser_dbuser
DB_PASSWORD="StrongProductionPassword123!"

# Session & Sanctum Stateful Configuration (Sibling Subdomain Cookies)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.sardaunatechlabs.com.ng
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Sanctum Stateful Domains (Enables auth cookie sharing between sibling subdomains)
SANCTUM_STATEFUL_DOMAINS=muhammad.sardaunatechlabs.com.ng,sardauna-portfolio.vercel.app,localhost:5173
FRONTEND_URL=https://muhammad.sardaunatechlabs.com.ng
CORS_ALLOWED_ORIGINS=https://muhammad.sardaunatechlabs.com.ng,https://sardauna-portfolio.vercel.app,http://localhost:5173

# Admin Initial Credentials (Used during initial seeding)
ADMIN_NAME="Muhammad Auwal Abubakar"
ADMIN_EMAIL="admin@sardaunatech.com"
ADMIN_PASSWORD="StrongAdminPassword2026!"

# Cache & Queue (File / Database for WhoGoHost Shared Hosting)
CACHE_STORE=file
CACHE_PREFIX=
QUEUE_CONNECTION=sync

# Filesystem / Media Storage (Local Public Disk)
FILESYSTEM_DISK=public

# Mail Delivery (WhoGoHost Webmail SMTP or External SMTP e.g. Gmail / Brevo / Resend)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.sardaunatechlabs.com.ng
MAIL_PORT=465
MAIL_USERNAME=contact@sardaunatechlabs.com.ng
MAIL_PASSWORD="YourWebmailPasswordHere"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="contact@sardaunatechlabs.com.ng"
MAIL_FROM_NAME="Muhammad Auwal Abubakar"
RECEIVER_EMAIL="contact.sardaunatech@gmail.com"
