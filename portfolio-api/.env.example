APP_NAME="Auwal Portfolio API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database Configuration (MySQL 8.0+ / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sardauna_portfolio
DB_USERNAME=sardauna_user
DB_PASSWORD=your_secure_password_here

# Session & Sanctum Stateful Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=www.yourdomain.com,yourdomain.com,sardauna-portfolio.vercel.app,localhost:5173
FRONTEND_URL=https://www.yourdomain.com

# Cache & Queue (File / Database for Shared Hosting)
CACHE_STORE=database
CACHE_PREFIX=
QUEUE_CONNECTION=sync

# Filesystem / Media Storage
FILESYSTEM_DISK=public

# Mail Delivery (SMTP / Nodemailer Replacement)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=contact.sardaunatech@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contact.sardaunatech@gmail.com"
MAIL_FROM_NAME="Muhammad Auwal Abubakar"
RECEIVER_EMAIL="contact.sardaunatech@gmail.com"
